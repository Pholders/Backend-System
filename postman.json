{
  "info": {
    "_postman_id": "e-prescription-workflow",
    "name": "E-Prescription Workflow",
    "description": "Complete doctor workflow endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Doctor Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"seed.doc1@seed.test\",\n  \"password\": \"doctorpass123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/doctor/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "doctor", "login"]
        }
      }
    },
    {
      "name": "Get Doctor Appointments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer YOUR_DOCTOR_TOKEN"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users/doctor/appointments",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "doctor", "appointments"]
        }
      }
    },
    {
      "name": "Create Prescription",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_DOCTOR_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentId\": 3,\n  \"diagnosis\": \"Hypertension with Type 2 Diabetes Mellitus\",\n  \"clinicalNotes\": \"Patient presents with elevated blood pressure (BP: 145/92) and fasting glucose of 156 mg/dL. Currently on Lisinopril 10mg daily. Recommend addition of Metformin for better glycemic control. Patient counseled on lifestyle modifications including dietary changes and regular exercise.\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/prescriptions",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "prescriptions"]
        }
      }
    },
    {
      "name": "Add Medicine - Amlodipine",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_DOCTOR_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"medicine_name\": \"Amlodipine\",\n  \"dosage\": \"5mg\",\n  \"dosage_form\": \"tablet\",\n  \"route_of_administration\": \"oral\",\n  \"frequency\": \"Once daily\",\n  \"duration\": \"30 days\",\n  \"quantity\": 30,\n  \"instructions\": \"Take in the morning with or without food\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/prescriptions/PRESCRIPTION_ID/medicines",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "prescriptions", "PRESCRIPTION_ID", "medicines"]
        }
      }
    },
    {
      "name": "Add Medicine - Metformin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_DOCTOR_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"medicine_name\": \"Metformin\",\n  \"dosage\": \"500mg\",\n  \"dosage_form\": \"tablet\",\n  \"route_of_administration\": \"oral\",\n  \"frequency\": \"Twice daily\",\n  \"duration\": \"30 days\",\n  \"quantity\": 60,\n  \"instructions\": \"Take with meals to reduce gastrointestinal side effects\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/prescriptions/PRESCRIPTION_ID/medicines",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "prescriptions", "PRESCRIPTION_ID", "medicines"]
        }
      }
    },
    {
      "name": "Check Drug Interactions",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_DOCTOR_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prescriptionId\": PRESCRIPTION_ID\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/prescriptions/PRESCRIPTION_ID/check-interactions",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "prescriptions", "PRESCRIPTION_ID", "check-interactions"]
        }
      }
    },
    {
      "name": "Sign Prescription",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer YOUR_DOCTOR_TOKEN"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionToken\": \"YOUR_DOCTOR_TOKEN\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/prescriptions/PRESCRIPTION_ID/sign",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "prescriptions", "PRESCRIPTION_ID", "sign"]
        }
      }
    }
  ]
}