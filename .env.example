# ========================
# SERVER CONFIGURATION
# ========================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ========================
# DATABASE
# ========================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_NAME=pholders

# ========================
# JWT & SECURITY
# ========================
JWT_SECRET=your_jwt_secret_key_change_in_production
SESSION_SECRET=your_very_secure_session_secret_here_change_in_production

# ========================
# GOOGLE OAUTH
# ========================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/api/users/auth/google/callback

# ========================
# EMAIL CONFIGURATION (cPanel SMTP)
# ========================
EMAIL_HOST=mail.pholders.co.za
EMAIL_PORT=465
EMAIL_SECURE=true

# --- SMTP Auth (main sending account) ---
EMAIL_USER=noreply@pholders.co.za
EMAIL_PASSWORD=pholders"123@

# --- System / Transactional Emails ---
EMAIL_FROM_NOREPLY=noreply@pholders.co.za
EMAIL_FROM_AUTH=authentication@pholders.co.za
EMAIL_FROM_NOTIFICATIONS=notifications@pholders.co.za
EMAIL_FROM_APPOINTMENTS=appointments@pholders.co.za
EMAIL_FROM_PRESCRIPTIONS=prescriptions@pholders.co.za
EMAIL_FROM_PAYMENTS=payments@pholders.co.za

# --- Business / Contact Emails ---
EMAIL_HELLO=hello@pholders.co.za
EMAIL_SUPPORT=support@pholders.co.za
EMAIL_DOCTORS=doctors@pholders.co.za
EMAIL_PHARMACY=pharmacy@pholders.co.za
EMAIL_MEDICAL_AID=medicalaid@pholders.co.za
EMAIL_BILLING=billing@pholders.co.za
EMAIL_PARTNERS=partners@pholders.co.za
EMAIL_CAREERS=careers@pholders.co.za

# ========================
# PAYMENT PROCESSING (Stripe)
# ========================
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Payment settings
PLATFORM_FEE_PERCENTAGE=10
PAYMENT_CURRENCY=ZAR

# ========================
# REDIS CACHE
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================
# GEOLOCATION SERVICE (Optional)
# ========================
GEOLOCATION_API_KEY=your_geolocation_api_key

# ========================
# OPTIONAL: Third-party Services
# ========================
SMS_SERVICE_API_KEY=
SMS_SERVICE_ACCOUNT_ID=
ENCRYPTION_KEY=

