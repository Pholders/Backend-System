{
  "info": {
    "_postman_id": "patient-appointment-booking-v1",
    "name": "Patient Appointment Booking",
    "description": "Patient workflow - Signup, Login, Browse Doctors, Select Time Slots, Book Appointment, Make Payment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Patient Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('patient_email', jsonData.data.email);",
              "    pm.environment.set('patient_id', jsonData.data.userId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"patient.test@example.com\",\n  \"password\": \"patientpass123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"dateOfBirth\": \"1990-05-15\",\n  \"phoneNumber\": \"+27123456789\",\n  \"gender\": \"Male\",\n  \"identityNumber\": \"9005151234567\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/signup",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "signup"]
        }
      },
      "response": []
    },
    {
      "name": "2. Patient Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('patient_token', jsonData.data.token);",
              "    pm.environment.set('patient_id', jsonData.data.userId);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"patient.test@example.com\",\n  \"password\": \"patientpass123\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "login"]
        }
      },
      "response": []
    },
    {
      "name": "3. Get All Doctors",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.length > 0) {",
              "        pm.environment.set('doctor_id', jsonData.data[0].id);",
              "        pm.environment.set('doctor_name', jsonData.data[0].firstName + ' ' + jsonData.data[0].lastName);",
              "        pm.environment.set('consultation_fee', jsonData.data[0].consultationFee);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users/doctors",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "doctors"]
        }
      },
      "response": []
    },
    {
      "name": "4. Get Doctor Availability (Time Slots)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.length > 0) {",
              "        var slot = jsonData.data[0];",
              "        pm.environment.set('appointment_date', slot.date);",
              "        pm.environment.set('time_period', slot.period);",
              "        pm.environment.set('time_slot', slot.timeSlot);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users/doctors/{{doctor_id}}/availability?date=2026-06-02",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "doctors", "{{doctor_id}}", "availability"],
          "query": [
            {
              "key": "date",
              "value": "2026-06-02"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Book Appointment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('appointment_id', jsonData.data.appointmentId);",
              "    pm.environment.set('appointment_status', jsonData.data.status);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": {{doctor_id}},\n  \"appointmentDate\": \"2026-06-02\",\n  \"timePeriod\": \"morning\",\n  \"timeSlot\": \"08:00\",\n  \"reasonForVisit\": \"Regular checkup and blood pressure monitoring\",\n  \"consultationFee\": {{consultation_fee}}\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/users/appointments/book",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "appointments", "book"]
        }
      },
      "response": []
    },
    {
      "name": "6. Initialize Payment (Stripe)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('payment_id', jsonData.data.paymentId);",
              "    pm.environment.set('stripe_session_url', jsonData.data.sessionUrl);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentId\": {{appointment_id}},\n  \"amount\": {{consultation_fee}},\n  \"currency\": \"ZAR\",\n  \"paymentMethod\": \"stripe\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/payments/initialize",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "payments", "initialize"]
        }
      },
      "response": []
    },
    {
      "name": "7. Process Cash Payment",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('payment_status', jsonData.data.paymentStatus);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"appointmentId\": {{appointment_id}},\n  \"amount\": {{consultation_fee}},\n  \"currency\": \"ZAR\",\n  \"paymentMethod\": \"cash_on_arrival\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/payments/cash-on-arrival",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "payments", "cash-on-arrival"]
        }
      },
      "response": []
    },
    {
      "name": "8. Get Patient Appointments",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users/appointments",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "appointments"]
        }
      },
      "response": []
    },
    {
      "name": "9. Get Appointment Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patient_token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/api/users/appointments/{{appointment_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "users", "appointments", "{{appointment_id}}"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "patient_email",
      "value": ""
    },
    {
      "key": "patient_token",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "doctor_name",
      "value": ""
    },
    {
      "key": "consultation_fee",
      "value": ""
    },
    {
      "key": "appointment_date",
      "value": ""
    },
    {
      "key": "time_period",
      "value": ""
    },
    {
      "key": "time_slot",
      "value": ""
    },
    {
      "key": "appointment_id",
      "value": ""
    },
    {
      "key": "appointment_status",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "stripe_session_url",
      "value": ""
    },
    {
      "key": "payment_status",
      "value": ""
    }
  ]
}

